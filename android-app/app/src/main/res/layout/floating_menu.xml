<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/menu_bg"
    android:padding="12dp"
    android:layoutDirection="rtl">

    <!-- شريط السحب -->
    <LinearLayout
        android:id="@+id/menu_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/drag_handle_bg"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_title"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:text="×"
            android:textColor="@color/danger_red"
            android:background="@android:color/transparent"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- الشفافية -->
    <TextView
        android:id="@+id/label_alpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_opacity"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />

    <SeekBar
        android:id="@+id/seek_alpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- قسم العرض -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/section_visual"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Switch
        android:id="@+id/switch_esp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/switch_esp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- قسم التصويب -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/section_aim"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Switch
        android:id="@+id/switch_aimbot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/switch_aimbot"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/label_fov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_fov"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <SeekBar
        android:id="@+id/seek_fov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/label_smoothing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_smoothing"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <SeekBar
        android:id="@+id/seek_smoothing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- قسم الهدف -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/section_target"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btn_bone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/target_head"
        android:textSize="13sp" />

</LinearLayout>
