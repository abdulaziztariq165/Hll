<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/menu_bg"
    android:padding="12dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/menu_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/drag_handle_bg"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_title"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="×"
            android:textColor="@color/danger_red"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textSize="24sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/label_alpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_opacity"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="12dp" />
    <SeekBar
        android:id="@+id/seek_alpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="@color/accent_cyan" />

    <Switch
        android:id="@+id/switch_esp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/switch_esp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <Switch
        android:id="@+id/switch_aimbot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/switch_aimbot"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/label_fov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_fov"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="8dp" />
    <SeekBar
        android:id="@+id/seek_fov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="@color/accent_cyan" />

    <TextView
        android:id="@+id/label_smoothing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_smoothing"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="8dp" />
    <SeekBar
        android:id="@+id/seek_smoothing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="@color/accent_cyan" />

    <Button
        android:id="@+id/btn_bone"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="@string/target_head"
        android:textSize="14sp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#333333" />

</LinearLayout>
